rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /lostTickets/{ticketId} {

      function isVerifiedCvsuStudent() {
        return request.auth != null
          && request.auth.token.email.matches('.*@cvsu[.]edu[.]ph$');
      }

      function isOfficer() {
        return request.auth != null && (
          request.auth.token.officer == true ||
          request.auth.token.firebase.sign_in_provider == 'password'
        );
      }

      // ── Access rules ─────────────────────────────────────────────────────
      allow create: if isVerifiedCvsuStudent()
                    && request.resource.data.email == request.auth.token.email;

      // Student PII is visible and manageable by CSSO officers.
      allow read, update, delete: if isOfficer();
    }
  }
}

